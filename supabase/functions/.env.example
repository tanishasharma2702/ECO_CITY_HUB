# =============================================================================
# Supabase Edge Functions Environment Template (supabase/functions/.env.example)
# =============================================================================
# THIS IS A TEMPLATE ONLY — NOT A REAL CREDENTIAL.
# Do not commit real API keys or secrets to Git.
#
# This file documents the server-side environment secrets required by the three
# EcoCity Hub Supabase Edge Functions:
#   1. carbon-recommendations
#   2. civic-analysis
#   3. plant-analysis
#
# In local development with the Supabase CLI, you can create a local .env:
#   supabase functions serve --env-file supabase/functions/.env
#
# In production, set this secret directly in Supabase Edge Function Secrets:
#   supabase secrets set GEMINI_API_KEY=your_actual_gemini_api_key
#
# Or through Supabase Dashboard:
#   Project Settings -> Edge Functions -> Secrets -> Add "GEMINI_API_KEY"
# =============================================================================

GEMINI_API_KEY=
