# =============================================================================
# EcoCity Hub - Public Frontend Environment Variables Template (.env.example)
# =============================================================================
# THIS IS A TEMPLATE CONFIGURATION FILE — NOT A REAL CREDENTIAL FILE.
# Copy this file to .env and fill in your actual Supabase project values:
#   cp .env.example .env
#
# SECURITY WARNING:
# In Vite, variables prefixed with VITE_ are embedded into the client-side bundle
# and exposed publicly to the browser. ONLY public, safe credentials belong here.
#
# DO NOT ADD GEMINI_API_KEY OR SUPABASE SERVICE-ROLE KEYS HERE!
# The frontend does not need and MUST NOT contain the Gemini API key.
#
# All Gemini AI capabilities (Carbon Recommendations, Civic Issue Analysis,
# Plant Health Diagnosis) are routed securely through Supabase Edge Functions.
#
# Configure your Gemini API key strictly server-side using Supabase CLI:
#   supabase secrets set GEMINI_API_KEY=your_gemini_api_key
# Or via Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets.
# =============================================================================

# Public Supabase Client Configuration (fill in your project credentials)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
